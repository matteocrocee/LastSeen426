#HUD {
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* VITA */
#HealthLabel {
    position: absolute;
    left: 25px;
    top: 20px;

    font-size: 22px;
    color: white;

    -unity-font-style: bold;
}

/* MIRINO */
#Crosshair {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 30px;
    height: 30px;

    margin-left: -15px;
    margin-top: -15px;

    font-size: 28px;
    color: white;

    -unity-text-align: middle-center;
}

/* BASSO SINISTRA */
#BottomLeft {
    position: absolute;

    left: 25px;
    bottom: 25px;

    flex-direction: column;
}

#InteractionLabel {
    font-size: 18px;
    color: white;

    margin-bottom: 5px;
}

#InventoryLabel {
    font-size: 18px;
    color: white;
}

/* MESSAGGIO RACCOLTA */
#PickupMessage {
    position: absolute;

    left: 50%;
    bottom: 120px;

    width: 500px;
    height: 40px;

    margin-left: -250px;

    font-size: 22px;
    color: white;

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    display: none;
}

/* ========================= */
/* INVENTARIO */
/* ========================= */

#InventoryScreen {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 700px;
    height: 500px;

    margin-left: -350px;
    margin-top: -250px;

    background-color: rgba(0, 0, 0, 0.9);

    display: none;
}

#InventoryTitle {
    position: absolute;

    left: 0;
    top: 25px;

    width: 100%;
    height: 50px;

    font-size: 32px;
    color: white;

    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* GRIGLIA DEGLI OGGETTI */
#InventoryGrid {
    position: absolute;

    left: 35px;
    right: 35px;

    top: 95px;
    bottom: 70px;

    flex-direction: row;
    flex-wrap: wrap;

    align-content: flex-start;
}

/* SINGOLO SLOT */
.inventory-slot {
    width: 140px;
    height: 155px;

    margin-right: 15px;
    margin-bottom: 15px;

    background-color: rgba(255, 255, 255, 0.08);

    align-items: center;
}

/* IMMAGINE */
.inventory-image {
    width: 90px;
    height: 90px;

    margin-top: 10px;
}

/* NOME */
.inventory-name {
    width: 130px;
    height: 25px;

    margin-top: 5px;

    font-size: 16px;
    color: white;

    -unity-text-align: middle-center;
}

/* QUANTITÀ */
.inventory-quantity {
    width: 130px;
    height: 20px;

    font-size: 14px;
    color: white;

    -unity-text-align: middle-center;
}

/* INVENTARIO VUOTO */
.inventory-empty {
    width: 100%;
    height: 50px;

    font-size: 20px;
    color: white;

    -unity-text-align: middle-center;
}

/* CHIUDI */
#InventoryClose {
    position: absolute;

    left: 0;
    bottom: 20px;

    width: 100%;
    height: 30px;

    font-size: 18px;
    color: white;

    -unity-text-align: middle-center;
}

/* ========================= */
/* MORTE */
/* ========================= */

#DeathScreen {
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    display: none;

    background-color: rgba(0, 0, 0, 0.55);
}

#DeathLabel {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 400px;
    height: 80px;

    margin-left: -200px;
    margin-top: -40px;

    font-size: 50px;
    color: white;

    -unity-font-style: bold;
    -unity-text-align: middle-center;
}