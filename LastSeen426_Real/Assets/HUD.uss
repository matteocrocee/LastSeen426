#HUD {
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}


/* =========================
   VITA
   ========================= */

#HealthLabel {
    position: absolute;

    left: 25px;
    top: 20px;

    font-size: 22px;
    color: white;

    -unity-font-style: bold;
}


/* =========================
   MIRINO
   ========================= */

#Crosshair {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 30px;
    height: 30px;

    margin-left: -15px;
    margin-top: -15px;

    font-size: 28px;
    color: white;

    -unity-text-align: middle-center;
}


/* =========================
   BASSO SINISTRA
   ========================= */

#BottomLeft {
    position: absolute;

    left: 25px;
    bottom: 25px;

    flex-direction: column;
}

#InteractionLabel {
    font-size: 18px;
    color: white;

    margin-bottom: 5px;
}

#InventoryLabel {
    font-size: 18px;
    color: white;
}


/* =========================
   MESSAGGIO OGGETTO
   ========================= */

#PickupMessage {
    position: absolute;

    left: 50%;
    bottom: 120px;

    width: 500px;
    height: 40px;

    margin-left: -250px;

    font-size: 22px;
    color: white;

    -unity-font-style: bold;

    -unity-text-align: middle-center;

    display: none;
}


/* =========================
   INVENTARIO
   ========================= */

#InventoryScreen {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 600px;
    height: 450px;

    margin-left: -300px;
    margin-top: -225px;

    background-color: rgba(0, 0, 0, 0.9);

    display: none;
}


/* TITOLO */

#InventoryTitle {
    position: absolute;

    left: 0;
    top: 25px;

    width: 100%;
    height: 50px;

    font-size: 32px;
    color: white;

    -unity-font-style: bold;

    -unity-text-align: middle-center;
}


/* OGGETTI */

#InventoryItems {
    position: absolute;

    left: 40px;
    top: 100px;

    right: 40px;
    bottom: 80px;

    font-size: 22px;
    color: white;
}


/* CHIUDI */

#InventoryClose {
    position: absolute;

    left: 0;
    bottom: 20px;

    width: 100%;
    height: 30px;

    font-size: 18px;
    color: white;

    -unity-text-align: middle-center;
}


/* =========================
   MORTE
   ========================= */

#DeathScreen {
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    display: none;

    background-color: rgba(0, 0, 0, 0.55);
}


#DeathLabel {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 400px;
    height: 80px;

    margin-left: -200px;
    margin-top: -40px;

    font-size: 50px;
    color: white;

    -unity-font-style: bold;

    -unity-text-align: middle-center;
}