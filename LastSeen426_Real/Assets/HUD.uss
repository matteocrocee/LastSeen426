/* ===================================================== */
/* HUD PRINCIPALE                                        */
/* ===================================================== */

#HUD {
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    width: 100%;
    height: 100%;
}


/* ===================================================== */
/* VITA                                                  */
/* ===================================================== */

#HealthLabel {
    position: absolute;

    left: 20px;
    top: 20px;

    color: white;

    font-size: 24px;

    -unity-font-style: bold;
}


/* ===================================================== */
/* MIRINO                                                */
/* ===================================================== */

#Crosshair {
    position: absolute;

    left: 50%;
    top: 50%;

    translate: -50% -50%;

    color: white;

    font-size: 28px;

    -unity-font-style: bold;
}


/* ===================================================== */
/* PARTE IN BASSO A SINISTRA                             */
/* ===================================================== */

#BottomLeft {
    position: absolute;

    left: 20px;
    bottom: 20px;

    flex-direction: column;
}


/* INTERAZIONE */

#InteractionLabel {
    color: white;

    font-size: 20px;

    margin-bottom: 8px;
}


/* INVENTARIO */

#InventoryLabel {
    color: white;

    font-size: 20px;
}


/* ===================================================== */
/* MESSAGGIO RACCOLTA                                    */
/* ===================================================== */

#PickupMessage {
    position: absolute;

    left: 50%;
    top: 15%;

    translate: -50% 0;

    color: white;

    font-size: 24px;

    -unity-font-style: bold;
}


/* ===================================================== */
/* SCHERMATA INVENTARIO                                  */
/* ===================================================== */

#InventoryScreen {
    position: absolute;

    left: 50%;
    top: 50%;

    translate: -50% -50%;

    width: 700px;
    height: 500px;

    flex-direction: column;

    align-items: center;

    background-color: rgba(20, 20, 20, 0.95);

    border-width: 3px;
    border-color: white;

    padding-top: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    padding-right: 30px;
}


/* TITOLO INVENTARIO */

#InventoryTitle {
    color: white;

    font-size: 40px;

    -unity-font-style: bold;

    margin-bottom: 30px;
}


/* GRIGLIA INVENTARIO */

#InventoryGrid {
    flex-grow: 1;

    width: 100%;

    flex-direction: row;

    flex-wrap: wrap;

    align-items: flex-start;
}


/* SLOT */

.inventory-slot {
    width: 130px;
    height: 150px;

    margin: 10px;

    align-items: center;

    background-color: rgba(60, 60, 60, 0.9);

    border-width: 2px;
    border-color: white;
}


/* IMMAGINE */

.inventory-image {
    width: 80px;
    height: 80px;

    margin-top: 10px;
}


/* NOME */

.inventory-name {
    color: white;

    font-size: 16px;

    margin-top: 8px;

    -unity-text-align: middle-center;
}


/* QUANTITÀ */

.inventory-quantity {
    color: white;

    font-size: 18px;

    -unity-font-style: bold;
}


/* INVENTARIO VUOTO */

.inventory-empty {
    color: white;

    font-size: 22px;
}


/* CHIUDI */

#InventoryClose {
    color: white;

    font-size: 18px;

    margin-top: 20px;
}


/* ===================================================== */
/* SCHERMATA MORTE                                      */
/* ===================================================== */

#DeathScreen {
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    width: 100%;
    height: 100%;

    align-items: center;
    justify-content: center;

    flex-direction: column;

    background-color: rgba(0, 0, 0, 0.80);
}


/* TITOLO MORTE */

#DeathLabel {
    color: white;

    font-size: 70px;

    -unity-font-style: bold;

    margin-bottom: 40px;
}


/* PULSANTE MORTE */

#RestartButton {
    width: 300px;
    height: 65px;

    font-size: 24px;

    color: white;

    background-color: rgba(40, 40, 40, 0.95);

    border-width: 2px;
    border-color: white;
}


/* HOVER */

#RestartButton:hover {
    background-color: rgba(80, 80, 80, 0.95);
}


/* TESTO R */

#RestartHint {
    color: white;

    font-size: 18px;

    margin-top: 20px;
}


/* ===================================================== */
/* MENU PAUSA                                            */
/* ===================================================== */

#PauseScreen {
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    width: 100%;
    height: 100%;

    align-items: center;
    justify-content: center;

    flex-direction: column;

    background-color: rgba(0, 0, 0, 0.85);
}


/* TITOLO PAUSA */

#PauseTitle {
    color: white;

    font-size: 70px;

    -unity-font-style: bold;

    margin-bottom: 40px;
}


/* PULSANTI PAUSA */

#ResumeButton,
#PauseRestartButton,
#QuitButton {
    width: 320px;
    height: 65px;

    margin-top: 8px;
    margin-bottom: 8px;

    font-size: 24px;

    color: white;

    background-color: rgba(40, 40, 40, 0.95);

    border-width: 2px;
    border-color: white;
}


/* HOVER PAUSA */

#ResumeButton:hover,
#PauseRestartButton:hover,
#QuitButton:hover {
    background-color: rgba(80, 80, 80, 0.95);
}