<?xml version="1.0" encoding="utf-8"?>

<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd"
>

    <!-- FOGLIO DI STILE -->
    <ui:Style src="HUD.uss" />

    <!-- HUD PRINCIPALE -->
    <ui:VisualElement name="HUD">

        <!-- ============================== -->
        <!-- VITA -->
        <!-- ============================== -->

        <ui:Label
            name="HealthLabel"
            text="♥ VITA: 100"
        />

        <!-- ============================== -->
        <!-- MIRINO -->
        <!-- ============================== -->

        <ui:Label
            name="Crosshair"
            text="•"
        />

        <!-- ============================== -->
        <!-- INFORMAZIONI IN BASSO A SINISTRA -->
        <!-- ============================== -->

        <ui:VisualElement name="BottomLeft">

            <ui:Label
                name="InteractionLabel"
                text="[E] INTERAGISCI"
            />

            <ui:Label
                name="InventoryLabel"
                text="[TAB] INVENTARIO"
            />

        </ui:VisualElement>

        <!-- ============================== -->
        <!-- MESSAGGIO RACCOLTA -->
        <!-- ============================== -->

        <ui:Label
            name="PickupMessage"
            text=""
        />

        <!-- ============================== -->
        <!-- INVENTARIO -->
        <!-- ============================== -->

        <ui:VisualElement name="InventoryScreen">

            <ui:Label
                name="InventoryTitle"
                text="INVENTARIO"
            />

            <ui:VisualElement
                name="InventoryGrid"
            />

            <ui:Label
                name="InventoryClose"
                text="[TAB] CHIUDI"
            />

        </ui:VisualElement>

        <!-- ============================== -->
        <!-- MORTE -->
        <!-- ============================== -->

        <ui:VisualElement name="DeathScreen">

            <ui:Label
                name="DeathLabel"
                text="SEI MORTO"
            />

            <ui:Button
                name="RestartButton"
                text="RICOMINCIA"
            />

            <ui:Label
                name="RestartHint"
                text="Premi R per ricominciare"
            />

        </ui:VisualElement>

        <!-- ============================== -->
        <!-- PAUSA -->
        <!-- ============================== -->

        <ui:VisualElement name="PauseScreen">

            <ui:Label
                name="PauseTitle"
                text="PAUSA"
            />

            <ui:Button
                name="ResumeButton"
                text="RIPRENDI"
            />

            <ui:Button
                name="PauseRestartButton"
                text="RICOMINCIA"
            />

            <ui:Button
                name="QuitButton"
                text="ESCI DAL GIOCO"
            />

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>